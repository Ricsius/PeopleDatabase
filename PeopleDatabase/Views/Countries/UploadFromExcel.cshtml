@{
    ViewBag.Title = "Upload countries from Excel";
}

<h2>Upload countries from Excel</h2>

<a href="~/Templates/Template_Countries.xlsx">Excel template</a>

<form asp-controller="Countries" asp-action="UploadFromExcel"
      method="post" enctype="multipart/form-data">
      <div class="form-field flex">
        <div class="w-25">
            <label class="form-label pt">Choose an xlsx file</label>
        </div>

        <div class="flex-1">
            <input class="form-input" type="file" name="excelFile" />
            <div class="text-red">@ViewBag.ErrorMessage</div>
            <div class="text-green">@ViewBag.Message</div>
        </div>
      </div>

      <div class="form-field flex">
          <div class="w-25"></div>
          <div class="flex-1">
              <button class="button button-green-back" type="submit">Upload</button>
          </div>
      </div>
</form>