<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/StyleSheet.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" integrity="sha512-KfkfwYDsLkIlwQp6LFnl8zNdLGxu9YAA1QvwINks4PhcElQSvqcyVLLD9aMhXd13uQjoXtEKNosOWaZqXgel0g==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <div class="container">
        <div class="navbar">
            <div class="navbar-brand">
                <img src="~/logo.png" asp-append-version="true" width="25px"/>
            </div>
            <ul>
                <li>
                    <a asp-controller="People" asp-action="Index">People</a>
                    <a asp-controller="People" asp-action="Create">Create Person</a>
                    <a asp-controller="Countries" asp-action="UploadFromExcel">Upload Countries</a>
                    <a asp-controller="People" asp-action="PeoplePdf">Download as PDF</a>
                    <a asp-controller="People" asp-action="PeopleCsv">Download as CSV</a>
                    <a asp-controller="People" asp-action="PeopleExcel">Download as Excel</a>
                </li>
            </ul>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>
